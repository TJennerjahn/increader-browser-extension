{
  "name": "increader-browser-extension",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs --mode production",
    "build:dev": "node scripts/build.mjs --mode development",
    "browser:test": "node scripts/browser-smoke.mjs",
    "browser:test:matrix": "npm run browser:test",
    "build:reproducible": "node scripts/check-reproducible.mjs",
    "dependency:audit": "npm audit --omit=dev --audit-level=high && node scripts/license-audit.mjs",
    "lint": "eslint . --max-warnings=0",
    "release:static": "npm run build:reproducible && npm run inspect && npm run web-ext:lint && npm run dependency:audit && npm run signing:check",
    "release:verify": "npm run release:static && npm run browser:test:matrix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "protocol:generate": "openapi-typescript protocol/browser-capture.openapi.yaml -o src/protocol/generated/browser-capture.ts",
    "protocol:check": "node scripts/check-protocol.mjs",
    "signing:check": "node scripts/check-signing-boundary.mjs",
    "inspect": "node scripts/inspect-build.mjs",
    "web-ext:lint": "node scripts/web-ext-lint.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run protocol:check && npm run build:dev && npm run release:static"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@types/chrome": "0.2.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "fake-indexeddb": "6.2.4",
    "fflate": "0.8.3",
    "geckodriver": "6.1.1",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "puppeteer": "25.3.0",
    "selenium-webdriver": "4.46.0",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "web-ext": "10.5.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0",
    "shell-quote": "1.10.0"
  }
}
