{
  "manifest_version": 3,
  "name": "Increader Browser Capture",
  "version": "0.1.0",
  "description": "Send the current page to your paired Increader instance.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Increader Browser Capture",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-capture@increader.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
