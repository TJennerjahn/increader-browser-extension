{
  "manifest_version": 3,
  "name": "Increader Browser Capture",
  "version": "0.1.0",
  "description": "Sign in and send the current page to your Increader instance.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://app.increader.com/*",
    "https://clerk.increader.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Increader Browser Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-capture@increader.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "browsingActivity", "websiteContent"]
      }
    }
  }
}
