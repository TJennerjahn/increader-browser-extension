{
  "manifest_version": 3,
  "name": "Increader Browser Capture",
  "version": "0.1.0",
  "description": "Send the current page to your paired Increader instance.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Increader Browser Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
