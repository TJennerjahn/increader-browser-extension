{
  "protocol": "increader-browser-capture",
  "displayName": "Increader",
  "pairingAvailable": true,
  "capabilities": [
    "pairing",
    "bookmark-lookup",
    "capture-package"
  ],
  "limits": {
    "multipartRequestBytes": 67108864,
    "manifestBytes": 524288,
    "documentHtmlBytes": 5242880,
    "domElements": 100000,
    "assetRecords": 1000,
